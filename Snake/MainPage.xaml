<Page
    x:Class="Snake.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Snake"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    UseSystemFocusVisuals="True"
    Background="#1E1E1E"
    KeyDown="Page_KeyDown">

    <Grid Padding="48">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   HorizontalAlignment="Center"
                   Margin="0,20,0,10"
                   FontSize="36"
                   FontWeight="Bold"
                   Foreground="White"
                   Text="Snake"/>

        <Canvas Grid.Row="1"
                x:Name="GameArea"
                Width="400"
                Height="400"
                HorizontalAlignment="Center"
                Background="#0A0A0A"
                Margin="0,10,0,10"/>

        <TextBlock Grid.Row="2"
                   x:Name="ScoreText"
                   HorizontalAlignment="Center"
                   Margin="0,5,0,10"
                   FontSize="24"
                   Foreground="White"
                   Text="Punkte: 0"/>

        <TextBlock Grid.Row="3"
                   x:Name="GameOverText"
                   HorizontalAlignment="Center"
                   Margin="0,5,0,10"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="Red"
                   Visibility="Collapsed"
                   Text="Spiel beendet!"/>

        <StackPanel Grid.Row="4"
                    HorizontalAlignment="Center"
                    Orientation="Vertical">
            <Button x:Name="StartButton"
                     MinHeight="48"
                    Content="Neustart"
                    HorizontalAlignment="Center"
                    Margin="0,5,0,10"
                    Click="StartButton_Click"/>
            <TextBlock HorizontalAlignment="Center"
                       Margin="0,5,0,20"
                       FontSize="16"
                       Foreground="Gray"
                       Text="Steuerung: D-Pad zum Bewegen"/>
        </StackPanel>
    </Grid>
</Page>
